{
  "name": "collector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx src/index.ts",
    "sweep": "node --env-file=../../.env --import tsx src/index.ts",
    "migrate": "node --env-file=../../.env --import tsx src/migrate.ts",
    "spike:glue": "tsx src/spike-glue.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@apto/shared": "workspace:*",
    "@neondatabase/serverless": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
