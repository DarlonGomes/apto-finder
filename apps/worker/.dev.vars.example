# `wrangler dev` reads this. Local Postgres from docker-compose.yml by default;
# a Neon URL works too (the driver is picked from the host name).
DATABASE_URL=postgres://apto:apto@localhost:5432/apto
# Mail (login codes, invites, digest) is printed to the wrangler log locally:
# grab the 6-digit code from there to log in.
# APP_URL=http://localhost:8787
