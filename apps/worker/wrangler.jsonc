{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apto-finder",
  "main": "src/index.ts",
  // 2026-08-04+ turns nodejs_compat on by default, which `pg` needs for local Postgres.
  "compatibility_date": "2026-08-25",
  // SPA build output served as static assets; /api/* always hits the Worker
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Daily digest: 08:00 BRT (11:00 UTC), one per search, to its members.
  "triggers": { "crons": ["0 11 * * *"] },
  // Login codes, invites and the digest all go out through Cloudflare Email
  // Service (sends to any address). Without the binding or DIGEST_FROM, mail is
  // only logged, which is how local dev reads the login code. Secrets:
  //   wrangler secret put DIGEST_FROM   (sender address on your sending domain)
  //   wrangler secret put APP_URL       (link target in emails)
  "send_email": [{ "name": "EMAIL" }]
  // DATABASE_URL is a secret: wrangler secret put DATABASE_URL
  // For local dev, put it in apps/worker/.dev.vars (gitignored)
}
