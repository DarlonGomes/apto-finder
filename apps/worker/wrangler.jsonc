{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apto-finder",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // SPA build output served as static assets; /api/* always hits the Worker
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
  // DATABASE_URL is a secret: wrangler secret put DATABASE_URL
  // For local dev, put it in apps/worker/.dev.vars (gitignored)
}
